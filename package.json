{
  "name": "ask-robotic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --continue",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "db:generate": "turbo db:generate --filter=@ask/db",
    "db:migrate": "turbo db:migrate --filter=@ask/db",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
