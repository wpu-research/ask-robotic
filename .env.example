DATABASE_URL=postgres://ask:ask@localhost:5432/ask_robotic

# Arduino derleme servisi (POST /api/compile). Kapalıyken 503 döner.
# Açmadan önce docs/derleme-servisi.md'deki güvenlik notlarını oku (ideal: ayrı, ağsız konteyner).
COMPILE_ENABLED=false
# arduino-cli yürütülebilir dosyasının yolu
ARDUINO_CLI=arduino-cli

# Robi (AI öğretmen). Claude öncelikli; yoksa geçici yedek NVIDIA API kataloğu. İkisi de yoksa Robi "çevrimdışı".
ANTHROPIC_API_KEY=
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Robi'nin doğal sesi (/api/tts). Boşsa tarayıcının sesi kullanılır. azure | google | elevenlabs | openai
TTS_PROVIDER=
# AZURE_SPEECH_KEY=  AZURE_SPEECH_REGION=westeurope
# GOOGLE_TTS_API_KEY=
# ELEVENLABS_API_KEY=  (ses: TTS_VOICE=<ses kimliği>)
# OPENAI_API_KEY=
# TTS_VOICE_TR= TTS_VOICE_EN=   (isteğe bağlı ses seçimi)
# TTS_DAILY_CHAR_LIMIT=2000000  (tüm site için günlük yeni sentez karakter tavanı)

# E-posta (doğrulama + "şifremi unuttum"). Hepsi dolu değilse özellik kapalıdır; kayıt/giriş etkilenmez.
# Zoho: SMTP_HOST=smtp.zoho.eu, SMTP_PORT=465 (SSL) ya da 587 (STARTTLS). Gerçek değerleri yalnız ortamda (Railway) ver.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Bağlantıların kökü, ör. https://siteadresi.com (sonda / olmadan)
APP_URL=
